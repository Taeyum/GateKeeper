# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다.
#   cp .env.example .env

# 실행 설정
LLM_PROVIDER=ollama
GK_VERSION=v2
# MODEL_*는 비워 두면 provider 기본값을 쓴다 (ollama: qwen3:8b / qwen3:0.6b, anthropic: claude-sonnet-5-5 / claude-haiku-5-5,
# judge는 anthropic에서 claude-opus-5-5). 값을 넣으면 provider와 상관없이 그대로 쓰이므로 provider를 바꿀 때는 같이 바꾼다.
# eval/run_eval.py는 provider와 모델 이름이 안 맞으면 LLM을 부르기 전에 멈춘다.
# MODEL_MAIN=qwen3:8b
# MODEL_SMALL=qwen3:0.6b
# MODEL_JUDGE=
# EMBED_MODEL=bge-m3

# API 키 (사용하는 provider만 채운다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=gatekeeper
